{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}