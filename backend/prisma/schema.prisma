// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Item {
  id       String @id
  name     String
  iconPath String?
}

model Factory {
  id               String @id
  name             String
  iconPath         String?
  inputSlots       Int?
  outputSlots      Int?
  powerConsumption Float?
}

model Recipe {
  className   String  @id
  name        String
  duration    Float

  ingredients Json
  products    Json
  producedIn  Json

  customRecipe Boolean @default(false)
  inBuildGun   Boolean

  alternate    Boolean?
}
